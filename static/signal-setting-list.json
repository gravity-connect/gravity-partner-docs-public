      "internalKeys": ["v2g-max-capacity"],
      "docs": {
        "unit": "Wh",
        "isSignal": true,
        "description": "Maximum energy capacity for the device",
        "frequency": "Daily"
      }
    },
    "present-capacity": {
      "type": "Float",
      "isSignal": true,
      "internalKeys": ["v2g-present-capacity"],
      "docs": {
        "description": "Remaining energy capacity for the device",
        "unit": "Wh",
        "freqency": "1 min"
      }
    },
    "max-usable-capacity": {
      "type": "Float",
      "isSignal": true,
      "internalKeys": ["v2g-max-usable-capacity"],
      "docs": {
        "description": "Maximum usable energy capacity for the device",
        "unit": "Wh",
        "frequency": "On Change or Daily"
      }
    },
    "present-usable-capacity": {
      "type": "Float",
      "isSignal": true,
      "internalKeys": ["v2g-present-usable-capacity"],
      "docs": {
        "description": "Usable energy capacity remaining in the device",
        "unit": "Wh"
      }
    },
    "discharge-power": {
      "type": "Float",
      "isSignal": true,
      "transformValue": ["invertSign"],
      "internalKeys": ["v2g-power"],
      "docs": {
        "description": "Present discharge power. Unsigned.",
        "unit": "W",
        "freqency": "1 min"
      }
    },
    "charge-power": {
      "type": "Float",
      "isSignal": true,
      "internalKeys": ["v2g-power"],
      "docs": {
        "description": "Present charge power. Unsigned.",
        "unit": "W",
        "freqency": "1 min"
      }
    },
    "max-discharge-power": {
      "type": "Float",
      "isSignal": true,
      "internalKeys": ["v2g-max-power"],
      "docs": {
        "description": "Maximum discharge power. Often fixed, but not always.",
        "unit": "W",
        "frequency": "On Change or Daily"
      }
    },
    "max-charge-power": {
      "type": "Float",
      "isSignal": true,
      "internalKeys": ["v2g-max-charge-power"],
      "docs": {
        "description": "Maximum charge power. Often fixed, but not always. Often equivalent to max-discharge-power, but not always.",
        "unit": "W",
        "frequency": "On Change or Daily"
      }
    },
    "house-power": {
      "type": "Float",
      "isSignal": true,
      "internalKeys": ["v2g-house-power"],
      "docs": {
        "description": "Present load consumed by the site. Unsigned",
        "unit": "W",
        "freqency": "1 min"
      }
    },
    "pv-power": {
      "type": "Float",
      "isSignal": true,
      "docs": {
        "description": "Present power being generated by PV panels attached to the system. Unsigned",
        "unit": "W",
        "freqency": "1 min"
      }
    },
    "state": {
      "type": "String",
      "isSignal": true,
      "docs": {
        "exampleValues": ["UNREACHABLE", "AVAILABLE", "INUSE"],
        "description": "State of use of the device (most commonly used for EV chargers)"
      }
    },
    "power-limit": {
      "type": "Float",
      "isSignal": true,
      "internalKeys": ["v2g-power-limit"],
      "docs": {
        "description": "Max power presently allowed to charger; this is where we would expect to see a DR curtailment take effect",
        "unit": "W"
      }
    }
  },
  "evse": {
    "status": {
      "type": "String",
      "values": ["OFFLINE", "ONLINE"],
      "isSignal": true,
      "docs": {
        "description": "Internet connectivity of the device",
        "frequency": "On Change or Daily if no change"
      }
    },
    "mode": {
      "type": "String",
      "values": ["INUSE", "AVAILABLE", "NEEDS_SERVICE"],
      "isSignal": true,
      "internalKeys": ["evse-mode"],
      "docs": {
        "description": "The current operating state of the EVSE.",
        "frequency": "On Change or Daily if no change"
      }
    },
    "power": {
      "type": "Float",
      "isSignal": true,
      "internalKeys": ["evse-power"],
      "docs": {
        "description": "Current power consumption in Watts.",
        "exampleValues": [0.0, 4500],
        "unit": "W",
        "frequency": "5 min"
      }
    },
    "power-limit": {
      "type": "Float",
      "isSignal": true,
      "internalKeys": ["evse-power-limit"],
      "docs": {
        "description": "The current power limit applied at the EVSE.",
        "exampleValues": [0.0, 4500],
        "unit": "W",
        "frequency": "On Change or Daily if no change"
      }
    },
    "max-power": {
      "type": "Float",
      "isSignal": false,
      "internalKeys": ["evse-max-power"],
      "docs": {
        "description": "The maximum charging power that the EVSE supports.",
        "exampleValues": [0.0, 4500],
        "unit": "W"
      }
    }
  }
}
