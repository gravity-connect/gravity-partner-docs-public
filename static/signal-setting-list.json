{
  "battery": {
    "mode": {
      "type": "String",
      "internalKeys": ["battery-mode"],
      "isSignal": true,
      "docs": {
        "frequency": "On Change or every 1 hr if no change",
        "exampleValues": ["SELF_CONSUMPTION", "BACKUP", "CHARGE", "DISCHARGE", "STANDBY"]
      }
    },
    "status": {
      "type": "String",
      "values": ["OFFLINE", "ONLINE"],
      "isSignal": true,
      "docs": {
        "description": "Internet connectivity of the device",
        "frequency": "On Change or every 1 hr if no change"
      }
    },
    "grid-connection": {
      "type": "String",
      "values": ["CONNECTED", "DISCONNECTED"],
      "isSignal": true,
      "continuous": false,
      "docs": {
        "description": "Connectivity to the grid. Disconnections are typically temporary events that indicate power outages.",
        "frequency": "On Change or every 1 hr if no change"
      }
    },
    "max-capacity": {
      "type": "Float",
      "internalKeys": ["battery-max-capacity"],
      "isSignal": true,
      "docs": {
        "unit": "Wh",
        "description": "Maximum energy capacity for the device",
        "frequency": "Daily"
      }
    },
    "present-capacity": {
      "type": "Float",
      "isSignal": true,
      "internalKeys": ["battery-present-capacity"],
      "docs": {
        "description": "Remaining energy capacity for the device",
        "unit": "Wh",
        "freqency": "1 min"
      }
    },
    "max-usable-capacity": {
      "type": "Float",
      "internalKeys": ["battery-max-usable-capacity"],
      "isSignal": true,
      "docs": {
        "description": "Maximum usable energy capacity for the device",
        "unit": "Wh",
        "frequency": "On Change or Daily"
      }
    },
    "present-usable-capacity": {
      "type": "Float",
      "isSignal": true,
      "internalKeys": ["battery-present-usable-capacity"],
      "docs": {
        "description": "Usable energy capacity remaining in the device",
        "unit": "Wh",
        "freqency": "1 min"
      }
    },
    "discharge-power": {
      "type": "Float",
      "isSignal": true,
      "transformValue": ["invertSign"],
      "internalKeys": ["battery-power"],
      "docs": {
        "description": "Present discharge power. Unsigned.",
        "unit": "W",
        "freqency": "1 min"
      }
    },
    "charge-power": {
      "type": "Float",
      "isSignal": true,
      "internalKeys": ["battery-power"],
      "docs": {
        "description": "Present charge power. Unsigned.",
        "unit": "W",
        "freqency": "1 min"
      }
    },
    "max-discharge-power": {
      "type": "Float",
      "isSignal": true,
      "internalKeys": ["battery-max-power"],
      "docs": {
        "description": "Maximum discharge power. Often fixed, but not always.",
        "unit": "W",
        "frequency": "On Change or Daily"
      }
    },
    "max-charge-power": {
      "type": "Float",
      "isSignal": true,
      "internalKeys": ["battery-max-charge-power"],
      "docs": {
        "description": "Maximum charge power. Often fixed, but not always. Often equivalent to max-discharge-power, but not always.",
        "unit": "W",
        "frequency": "On Change or Daily"
      }
    },
    "house-power": {
      "type": "Float",
      "isSignal": true,
      "internalKeys": ["battery-house-power"],
      "docs": {
        "description": "Present load consumed by the site. Unsigned",
        "unit": "W",
        "freqency": "1 min"
      }
    },
    "pv-power": {
      "type": "Float",
      "isSignal": true,
      "docs": {
        "description": "Present power being generated by PV panels attached to the system. Unsigned",
        "unit": "W",
        "freqency": "1 min"
      }
    },
    "min-reserve-percent-mfg": {
      "type": "Float",
      "isSignal": false,
      "internalKeys": ["battery-min-reserve-percent-mfg"],
      "docs": {
        "description": "The minimum state of charge, in %, that this device can reach during DR events. Only include a reserve value set by the homeowner if it is respected during DR events.",
        "unit": "Percentage"
      }
    }
  },
  "hwh": {
    "mode": {
      "type": "String",
      "isSignal": true,
      "internalKeys": ["hwh-set-mode"],
      "transformValue": ["ctaLegacyModes"],
      "docs": {
        "description": "If additional modes are available, please let us know so we can consider standardized naming",
        "frequency": "On Change or every 1 hr if no change",
        "exampleValues": ["NORMAL", "SHED", "CRITICAL", "EMERGENCY", "LOAD_UP", "ADVANCED_LOAD_UP", "ERROR", "CYCLING", "PRICE_STREAM", "VARIABLE"],
        "additionalDocs": "Non-CTA devices are TBD"
      }
    },
    "status": {
      "type": "String",
      "values": ["OFFLINE", "ONLINE"],
      "isSignal": true,
      "docs": {
        "description": "Internet connectivity of the device",
        "frequency": "On Change or every 1 hr if no change"
      }
    },
    "tank-temperature": {
      "type": "Float",
      "isSignal": true,
      "internalKeys": ["hwh-tank-temperature"],
      "docs": {
        "description": "In the case that both top and bottom temperature are reported, this would be the top temperature.",
        "unit": "Degrees Fahrenheit",
        "frequency": "5 min",
        "additionalDocs": "Not relevant for CTA devices"
      }
    },
    "tank-bottom-temperature": {
      "type": "Float",
      "isSignal": true,
      "internalKeys": ["hwh-tank-bottom-temperature"],
      "docs": {
        "description": "Optional, not all water heaters report temperature at the top and bottom of the tank",
        "unit": "Degrees Fahrenheit",
        "frequency": "5 min",
        "additionalDocs": "Not relevant for CTA devices"
      }
    },
    "setpoint-temperature": {
      "type": "Float",
      "isSignal": true,
      "internalKeys": ["hwh-set-temperature"],
      "docs": {
        "unit": "Degrees Fahrenheit",
        "frequency": "On Change or Daily if no change"
      }
    },
    "present-capacity": {
      "type": "Float",
      "isSignal": true,
      "internalKeys": ["hwh-present-capacity"],
      "docs": {
        "unit": "Wh",
        "description": "For CTA2045, given the absence of tank-temperature / setpoint-temperature data",
        "frequency": "5 min"
      }
    },
    "max-capacity": {
      "type": "Float",
      "isSignal": true,
      "internalKeys": ["hwh-max-capacity"],
      "docs": {
        "unit": "Wh",
        "description": "For CTA2045, given the absence of tank-temperature / setpoint-temperature data",
        "frequency": "On Change or Daily if no change"
      }
    },
    "power": {
      "type": "Float",
      "isSignal": true,
      "docs": {
        "unit": "W",
        "frequency": "5 min",
        "additionalDocs": "Not relevant for CTA devices"
      }
    },
    "current": {
      "type": "Float",
      "isSignal": true,
      "internalKeys": ["hwh-current"],
      "docs": {
        "unit": "A",
        "description": "Optional, may not be available",
        "frequency": "5 min",
        "additionalDocs": "Not relevant for CTA devices"
      }
    },
    "voltage": {
      "type": "Float",
      "isSignal": true,
      "internalKeys": ["hwh-voltage"],
      "docs": {
        "unit": "V",
        "description": "Optional, may not be available",
        "frequency": "5 min",
        "additionalDocs": "Not relevant for CTA devices"
      }
    },
    "max-setpoint": {
      "type": "Float",
      "isSignal": false,
      "internalKeys": ["hwh-max-setpoint"],
      "docs": {
        "unit": "Degrees Fahrenheit",
        "description": "Defines the maximum setpoint that is allowed by the unit"
      }
    },
    "min-setpoint": {
      "type": "Float",
      "isSignal": false,
      "internalKeys": ["hwh-min-setpoint"],
      "docs": {
        "unit": "Degrees Fahrenheit",
        "description": "Defines the minimum setpoint that is allowed by the unit"
      }
    },
    "cta-advanced-loadup-enabled": {
      "type": "Boolean",
      "isSignal": false,
      "docs": {
        "description": "Optional setting used by CTA"
      }
    },
    "cta-user-preference-level": {
      "type": "Integer",
      "isSignal": false,
      "docs": {
        "description": "Optional setting used by CTA. Expected values 0-10"
      }
    },
    "cta-op-state": {
      "type": "String",
      "isSignal": true,
      "values": ["IDLE_NORMAL", "RUNNING_NORMAL", "RUNNING_CURTAILED", "RUNNING_HEIGHTENED", "IDLE_CURTAILED", "SGD_ERROR_CONDITION", "IDLE_HEIGHTENED", "CYCLING_ON", "CYCLING_OFF", "VARIABLE_FOLLOWING", "VARIABLE_NOT_FOLLOWING", "IDLE_OPTED_OUT", "IDLE_PRICE_STREAM", "RUNNING_OPTED_OUT", "RUNNING_PRICE_STREAM", "IDLE_PRICE_STREAM"],
      "docs": {
        "description": "Optional setting used by CTA",
        "frequency": "On Change or every 1 hr if no change"
      }
    },
    "cta-advanced-present-capacity": {
      "type": "Float",
      "isSignal": true,
      "docs": {
        "unit": "Wh",
        "description": "Required if CTA advanced load up is supported",
        "frequency": "5 min"
      }
    },
    "cta-advanced-max-capacity": {
      "type": "Float",
      "isSignal": true,
      "docs": {
        "unit": "Wh",
        "description": "Required if CTA advanced load up is supported",
        "frequency": "On Change or Daily if no change"
      }
    }
  },
  "tstat": {
    "mode": {
      "type": "String",
      "values": ["HEAT", "COOL", "AUTO", "FAN_ONLY"],
      "isSignal": true,
      "transformValue": ["toLowerCase"],
      "internalKeys": ["thermostat-mode"],
      "docs": {
        "frequency": "On Change or Daily if no change",
        "description": "Current mode of the device. Please use the following exact values for heating, cooling, automatic, and fan modes. This signal also accepts other modes supported by the device that are not listed here, such as 'DRY'."
      }
    },
    "status": {
      "type": "String",
      "values": ["OFFLINE", "ONLINE"],
      "isSignal": true,
      "docs": {
        "description": "Internet connectivity of the device"
      }
    },
    "state": {
      "type": "String",
      "values": ["ON", "OFF"],
      "isSignal": true,
      "internalKeys": ["thermostat-state"],
      "docs": {
        "description": "Whether the device is on or off",
        "frequency": "On Change or 1 hr if no change"
      }
    },
    "humidity": {
      "type": "Float",
      "isSignal": true,
      "internalKeys": ["thermostat-actual-humidity"],
      "docs": {
        "unit": "Percentage",
        "description": "Optional. Ambient humidity of the room, measured by the device. Range from 0 to 100",
        "frequency": "5 min"
      }
    },
    "temperature": {
      "type": "Float",
      "isSignal": true,
      "internalKeys": ["thermostat-actual-temperature"],
      "docs": {
        "description": "Ambient humidity of the room, measured by the device",
        "unit": "Degrees Fahrenheit",
        "frequency": "5 min"
      }
    },
    "cool-setpoint-temperature": {
      "type": "Float",
      "isSignal": true,
      "internalKeys": ["thermostat-cool-setpoint"],
      "docs": {
        "unit": "Degrees Fahrenheit",
        "description": "Optional; recommended if supported",
        "frequency": "On Change or Daily if no change"
      }
    },
    "heat-setpoint-temperature": {
      "type": "Float",
      "isSignal": true,
      "internalKeys": ["thermostat-heat-setpoint"],
      "docs": {
        "unit": "Degrees Fahrenheit",
        "description": "Optional; recommended if supported",
        "frequency": "On Change or Daily if no change"
      }
    },
    "louver-swing": {
      "type": "String",
      "isSignal": true,
      "internalKeys": ["thermostat-louver-swing"],
      "docs": {
        "exampleValues": ["AUTO", "FAST", "SLOW", "OFF", "ON"],
        "description": "Optional. Mode or speed of louver swing"
      }
    },
    "fan-mode": {
      "type": "String",
      "isSignal": true,
      "internalKeys": ["thermostat-fan-mode"],
      "docs": {
        "exampleValues": ["HIGH", "MEDIUM", "LOW", "OFF", "ON"],
        "frequency": "5 min",
        "description": "Optional. Mode or speed of fan"
      }
    },
    "equipment-status": {
      "type": "String",
      "internalKeys": ["hvac-equipment-status"],
      "isSignal": true,
      "docs": {
        "exampleValues": ["FAN ONLY", "HEATING", "HEATING STAGE 2", "NONE"],
        "frequency": "5 min",
        "description": "Optional. Describes which parts of the equipment are currently running (typically more specific than 'mode'"
      }
    },
    "runtime-fan": {
      "type": "Float",
      "isSignal": true,
      "internalKeys": ["thermostat-runtime-fan"],
      "docs": {
        "unit": "seconds",
        "description": "The number of seconds of runtime in the interval of time starting at the specified timestamp. Cadence: 5 minutes, clock-aligned",
        "frequency": "5 minutes, clock-aligned"
      }
    },
    "runtime-heat": {
      "type": "Float",
      "isSignal": true,
      "internalKeys": ["thermostat-runtime-heat"],
      "docs": {
        "unit": "seconds",
        "description": "The number of seconds of runtime in the interval of time starting at the specified timestamp. Cadence: 5 minutes, clock-aligned",
        "frequency": "5 minutes, clock-aligned"
      }
    },
    "runtime-cool": {
      "type": "Float",
      "isSignal": true,
      "internalKeys": ["thermostat-runtime-cool"],
      "docs": {
        "unit": "seconds",
        "description": "The number of seconds of runtime in the interval of time starting at the specified timestamp. Cadence: 5 minutes, clock-aligned",
        "frequency": "5 minutes, clock-aligned"
      }
    },
    "power": {
      "type": "Float",
      "isSignal": true,
      "internalKeys": ["thermostat-power"],
      "docs": {
        "unit": "kW",
        "description": "Optional, the instantaneous power consumed by this device at the specified timestamp. Cadence: >= 5 minutes (not required to be clock aligned)",
        "frequency": ">= 5 minutes (not necessary to be clock aligned)"
      }
    },
    "max-setpoint": {
      "type": "Float",
      "isSignal": false,
      "internalKeys": ["thermostat-max-setpoint"],
      "docs": {
        "unit": "Degrees Fahrenheit",
        "description": "Defines the maximum setpoint that is allowed by the unit"
      }
    },
    "min-setpoint": {
      "type": "Float",
      "isSignal": false,
      "internalKeys": ["thermostat-min-setpoint"],
      "docs": {
        "unit": "Degrees Fahrenheit",
        "description": "Defines the minimum setpoint that is allowed by the unit"
      }
    }
  },
  "v2g": {
    "mode": {
      "type": "String",
      "isSignal": true,
      "internalKeys": ["v2g-mode"],
      "docs": {
        "frequency": "On Change or every 1 hr if no change",
        "exampleValues": ["SELF_CONSUMPTION", "BACKUP", "CHARGE", "DISCHARGE", "STANDBY"]
      }
    },
    "status": {
